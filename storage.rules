rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/deletedAccounts/$(uid));
    }
    function ownerImageWrite(uid) {
      return isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024  // 10 MB
        && request.resource.contentType.matches("image/.*");
    }

    // Shared, authenticated-readable content (renders in feed/leaderboard).
    match /users/{uid}/pets/{petId}/{allPaths=**} {
      allow read: if request.auth != null;
    }
    match /users/{uid}/posts/{postId}/{allPaths=**} {
      function sharedWithViewer() {
        let post = firestore.get(/databases/(default)/documents/posts/$(postId)).data;
        return post.authorUid == uid && (post.visibility == "public"
          || (post.visibility == "friends"
            && firestore.exists(/databases/(default)/documents/users/$(uid)/friends/$(request.auth.uid))));
      }
      allow get: if request.auth != null && sharedWithViewer();
    }
    match /users/{uid}/walks/{walkId}/{allPaths=**} {
      function sharedWithViewer() {
        let walk = firestore.get(/databases/(default)/documents/walks/$(walkId)).data;
        return walk.walkerUid == uid && walk.familyId is string
          && request.auth.uid in firestore.get(/databases/(default)/documents/families/$(walk.familyId)).data.memberUids;
      }
      allow get: if request.auth != null && sharedWithViewer();
    }

    // Default for everything else under a user's namespace: OWNER-ONLY read.
    // Closes the blanket-read hole; future private uploads are safe by default.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if ownerImageWrite(uid);
      allow delete: if isOwner(uid);
    }
  }
}
