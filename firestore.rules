rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A server-only deletion checkpoint freezes mutations even while an old
    // ID token remains valid. Keep reads unchanged for cleanup UX.
    function activeAccount() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/deletedAccounts/$(request.auth.uid));
    }

    // Helper: is `uid` a member of `familyId`?
    function inFamily(familyId, uid) {
      return exists(/databases/$(database)/documents/families/$(familyId))
        && uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    // Helper: does the request's auth match a member of this family?
    function isFamilyMember(familyId) {
      return request.auth != null && inFamily(familyId, request.auth.uid);
    }

    // Helper: is the caller a guest (anonymous-auth) user? Guests may use
    // personal features (pets/walks/reminders/expenses — they're
    // authenticated, so the existing personal-owner rules already allow
    // them) but are blocked from ALL community surfaces (posts / comments /
    // reactions / families / friends) and excluded from the leaderboards
    // (aggregation skips them server-side). Token-based so it can't be
    // spoofed by a client writing isGuest=false on their own user doc.
    // Spec docs/features/guest-login.md §D.
    function isGuest() {
      return request.auth == null
        || request.auth.token.firebase.sign_in_provider == "anonymous";
    }
    // Convenience: signed in AND not a guest.
    function isRealUser() {
      return request.auth != null && !isGuest();
    }

    // ── Users & owned sub-collections ──
    function hasNoPublicContact(data) {
      return !data.keys().hasAny(["email", "fcmTokens"]);
    }

    match /users/{uid} {
      // The public profile doc holds ONLY non-sensitive fields needed by
      // leaderboard / friends / feed to render other users: displayName,
      // photoURL, displayNameLower, authProvider, isGuest (+ the caller's
      // own prefs). Any signed-in user may read it — required for those
      // features and now safe. PII (email, fcmTokens) lives in the
      // owner-only `private/contact` subdoc below (security-hardening #2);
      // Firestore reads are all-or-nothing per doc, so keeping PII OUT of
      // this doc is the only real protection (a client-side field filter
      // wouldn't be — the raw SDK read returns every field).
      allow read: if request.auth != null;
      allow create: if activeAccount() && (request.auth.uid == uid
        && request.resource.data.uid == uid
        && hasNoPublicContact(request.resource.data));
      allow update: if activeAccount() && (request.auth.uid == uid
        && hasNoPublicContact(request.resource.data));
      allow delete: if false;

      // ── Private contact PII (security-hardening #2) ──
      // email + fcmTokens, OWNER-ONLY. Cloud Functions read this via the
      // Admin SDK (rules bypass) to send push.
      match /private/{docId} {
        allow read: if request.auth.uid == uid;
        allow write: if activeAccount() && (request.auth.uid == uid);
      }

      // ── Legacy paths removed 2026-05-23 ──
      // The pre-family schema kept pets/reminders/walks/expenses under
      // users/{uid}/... . Migration (Phase 3+4, see family-provider.tsx
      // historical) moved everything to top-level collections with a
      // `familyId` field. The legacy sub-collections were drained by the
      // cleanupLegacyPaths callable + admin-script
      // (legacyCleanups/2026-05-23T14-01-53-045Z audit doc), so the
      // corresponding match blocks have been removed.
      //
      // If you need to add a new sub-collection under users/{uid}, do so
      // here following the friends/friendRequests/favoriteRestaurants
      // pattern below, not the deleted legacy pattern.

      // Friends + friendRequests are community features — guests are blocked
      // from writing (they have no real identity to befriend). Reads stay
      // open to the relevant parties so an upgraded ex-guest sees nothing
      // stale. Spec guest-login.md §C.
      match /friends/{friendUid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow write: if activeAccount() && (request.auth.uid == uid && isRealUser());
      }

      match /friendRequests/{requestId} {
        allow read: if request.auth.uid == uid;
        allow create: if activeAccount() && (isRealUser()
          && !exists(/databases/$(database)/documents/deletedAccounts/$(uid))
          && request.resource.data.fromUid == request.auth.uid
          && requestId == request.auth.uid);
        allow delete: if activeAccount() && (request.auth.uid == uid
          || request.auth.uid == requestId);
        allow update: if false;
      }

      match /favoriteRestaurants/{rid} {
        allow read: if request.auth.uid == uid;
        allow write: if activeAccount() && (request.auth.uid == uid);
      }

      match /knowledgeBookmarks/{articleId} {
        allow read: if request.auth.uid == uid;
        allow write: if activeAccount() && (request.auth.uid == uid);
      }

      // ── Achievements / badges (gamification) ──
      // Granted badge docs (users/{uid}/achievements/{achievementId}) +
      // the lifetime stats doc (users/{uid}/stats/lifetime). Both are
      // server-authoritative: the owner can READ their own, but ALL writes
      // go through Cloud Functions (Admin SDK bypasses rules) so a client
      // can't self-grant a badge or inflate their walk stats. Spec
      // docs/features/achievements-badges.md §B/§C.
      match /achievements/{achievementId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }

      match /stats/{statId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }

      match /photoDownloadState/{photoAssetId} {
        allow read: if request.auth.uid == uid;
        allow create, update: if activeAccount() && (request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            "assetId",
            "source",
            "sourceId",
            "urlHash",
            "downloadedAt",
            "mode"
          ])
          && request.resource.data.assetId == photoAssetId
          && request.resource.data.source in [
            "post",
            "walk",
            "pet-avatar",
            "expense-receipt"
          ]
          && request.resource.data.sourceId is string
          && request.resource.data.urlHash is string
          && request.resource.data.downloadedAt == request.time
          && request.resource.data.mode in ["share", "download"]);
        allow delete: if false;
      }
    }

    // ── Families ──
    // A family doc lists its members. Membership is a single source of truth
    // for all the family-scoped collections below.
    match /families/{familyId} {
      // Members can read their own family doc. The join-by-code path runs
      // server-side in a Cloud Function, so non-members never need read here.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      // No client writes — every create/update/delete goes through callables
      // (createFamily / joinFamilyByCode / leaveFamily / regenerateInviteCode
      // / removeFamilyMember). This keeps inviteCode generation, member
      // invariants, and last-member cleanup atomic and auditable.
      allow create, update, delete: if false;

      // Audit log for callable-driven family migrations (import-personal in
      // Phase B3, pet-merge in B4, future dedupe-migration). Members can
      // read their family's audit trail; writes go only through Admin SDK
      // in the callables.
      match /migrations/{migrationId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
        allow write: if false;
      }
    }

    // ── Family-scoped top-level collections ──
    // Two access modes per doc:
    //   1. FAMILY: `data.familyId != null` — any member of that family.
    //   2. PERSONAL: `data.familyId == null` — only the doc's owner
    //      (`ownerUid` / `walkerUid` / `createdByUid` / `payerUid` per
    //      collection; the canonical field is whatever the matching
    //      `create` rule already required for that collection).
    // Personal mode is the no-family default after onboarding; users
    // can migrate personal docs into a family later via the
    // `importPersonalToFamily` callable (Phase B3).
    //
    // Per-collection personal-owner predicates. We inline the field name
    // (rather than parameterising) because Firestore rules' dynamic field
    // access (`data[varName]`) is not documented to work reliably across
    // SDK versions — explicit predicates compile and behave the same way
    // every release.
    function isPersonalPetOwner(d) {
      return d.familyId == null && request.auth != null
        && d.ownerUid == request.auth.uid;
    }
    function petOwnerActive(d) {
      return d.ownerUid is string
        && !exists(/databases/$(database)/documents/deletedAccounts/$(d.ownerUid));
    }
    function isPersonalWalkOwner(d) {
      return d.familyId == null && request.auth != null
        && d.walkerUid == request.auth.uid;
    }
    function isPersonalReminderOwner(d) {
      return d.familyId == null && request.auth != null
        && d.createdByUid == request.auth.uid;
    }
    function isPersonalExpenseOwner(d) {
      return d.familyId == null && request.auth != null
        && d.payerUid == request.auth.uid;
    }

    // NOTE on `resource == null` clauses:
    //   The migration helpers call getDoc() to check whether a top-level
    //   doc with the same id as a legacy doc exists yet. When it doesn't,
    //   Firestore evaluates the rule with `resource == null`, and
    //   `resource.data.familyId` is undefined → permission denied. Allowing
    //   read of non-existing docs (which leak nothing — the snapshot just
    //   says "doesn't exist") fixes this and is a standard Firestore
    //   pattern for "did this doc get created yet?" checks. The `list`
    //   query for family pets/walks/etc. still uses the familyId filter
    //   so non-family members can't enumerate.

    match /pets/{petId} {
      allow read: if resource == null
        || isPersonalPetOwner(resource.data)
        || isFamilyMember(resource.data.familyId);
      allow create: if activeAccount() && (request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && (
          request.resource.data.familyId == null
          || isFamilyMember(request.resource.data.familyId)
        ));
      allow update: if activeAccount() && petOwnerActive(resource.data)
        && petOwnerActive(request.resource.data) && ((
          isPersonalPetOwner(resource.data)
          || isFamilyMember(resource.data.familyId)
        )
        && (
          // Post-state must also be accessible to the caller — either
          // still personal-owned-by-self, or in a family we belong to.
          isPersonalPetOwner(request.resource.data)
          || isFamilyMember(request.resource.data.familyId)
        ));
      allow delete: if activeAccount() && petOwnerActive(resource.data) && (isPersonalPetOwner(resource.data)
        || isFamilyMember(resource.data.familyId));

      // Health records flattened to a subcollection of pet at top-level.
      // Both reads and writes gated by the parent pet's family — or by
      // the parent pet's ownerUid in personal mode.
      match /healthRecords/{recordId} {
        function canAccessParent() {
          let parent = /databases/$(database)/documents/pets/$(petId);
          return request.auth != null && exists(parent)
            && (isPersonalPetOwner(get(parent).data)
                || isFamilyMember(get(parent).data.familyId));
        }
        // A surviving family member must not refill a deleting owner's pet
        // between the server's child cleanup and parent deletion.
        function canWriteParent() {
          return canAccessParent()
            && petOwnerActive(get(/databases/$(database)/documents/pets/$(petId)).data);
        }
        function requiredText(d, key, maxLength) {
          return key in d && d[key] is string
            && d[key].size() > 0 && d[key].size() <= maxLength;
        }
        function optionalText(d, key, maxLength) {
          return !(key in d) || (d[key] is string && d[key].size() <= maxLength);
        }
        function optionalDate(d, key) {
          return !(key in d) || d[key] is timestamp;
        }
        function validData(type, d) {
          return d is map && (
            (type == 'weight' && d.keys().hasOnly(['kg'])
              && d.kg is number && d.kg > 0 && d.kg <= 10000)
            || (type == 'feeding' && d.keys().hasOnly(['brand', 'amountG', 'foodType'])
              && optionalText(d, 'brand', 500) && optionalText(d, 'foodType', 500)
              && (!('amountG' in d)
                || (d.amountG is number && d.amountG >= 0 && d.amountG <= 1000000)))
            || (type == 'vaccine' && d.keys().hasOnly(['name', 'nextDueAt'])
              && requiredText(d, 'name', 500) && optionalDate(d, 'nextDueAt'))
            || (type == 'vet' && d.keys().hasOnly(['clinic', 'doctor', 'diagnosis', 'prescription'])
              && requiredText(d, 'clinic', 500) && requiredText(d, 'diagnosis', 10000)
              && optionalText(d, 'doctor', 500) && optionalText(d, 'prescription', 10000))
            || (type == 'medication' && d.keys().hasOnly(['name', 'frequency', 'startsAt', 'endsAt'])
              && requiredText(d, 'name', 500) && optionalText(d, 'frequency', 500)
              && optionalDate(d, 'startsAt') && optionalDate(d, 'endsAt'))
          );
        }
        function validContent(d) {
          return d.petId == petId && d.recordedAt is timestamp
            && (!('notes' in d) || d.notes == null
              || (d.notes is string && d.notes.size() <= 10000))
            && validData(d.type, d.data);
        }
        // Legacy records remain readable/deletable using only parent authority.
        allow read: if canAccessParent();
        allow delete: if activeAccount() && (canWriteParent());
        allow create: if activeAccount() && (canWriteParent()
          && request.resource.data.keys().hasAll([
            'petId', 'recordedByUid', 'type', 'data', 'recordedAt', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'petId', 'recordedByUid', 'type', 'data', 'recordedAt', 'notes', 'createdAt'
          ])
          && request.resource.data.recordedByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && validContent(request.resource.data));
        // Preserve legacy metadata and attribution when a family member edits content.
        allow update: if activeAccount() && (canWriteParent()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['type', 'data', 'recordedAt', 'notes'])
          && validContent(request.resource.data));
      }
    }

    match /walks/{walkId} {
      // The parent pet is the authority; client familyIds are not an ACL.
      function validWalkPet(d) {
        let pet = get(/databases/$(database)/documents/pets/$(d.petId)).data;
        return d.petId is string && d.petId.size() > 0
          && petOwnerActive(pet) && d.familyId == pet.familyId
          && (isPersonalPetOwner(pet) || isFamilyMember(pet.familyId));
      }
      allow read: if resource == null
        || isPersonalWalkOwner(resource.data)
        || isFamilyMember(resource.data.familyId);
      allow create: if activeAccount() && (request.auth != null
        && request.resource.data.walkerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validWalkPet(request.resource.data));
      // Updates allowed by the walker only (e.g., editing notes), in
      // both family and personal modes (walker == self covers both).
      allow update: if activeAccount() && request.auth.uid == resource.data.walkerUid
        && validWalkPet(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['notes', 'photoURLs']);
      allow delete: if activeAccount() && (isPersonalWalkOwner(resource.data)
        || isFamilyMember(resource.data.familyId));
    }

    match /reminders/{reminderId} {
      allow read: if resource == null
        || isPersonalReminderOwner(resource.data)
        || isFamilyMember(resource.data.familyId);
      allow create: if activeAccount() && (request.auth != null
        && request.resource.data.createdByUid == request.auth.uid
        && (
          request.resource.data.familyId == null
          || isFamilyMember(request.resource.data.familyId)
        ));
      // Any family member can mark done / edit / delete in family mode;
      // only the owner in personal mode. The doneByUid anti-impersonation
      // guard applies in both modes — if the update touches doneByUid it
      // must be cleared or equal request.auth.uid.
      allow update: if activeAccount() && ((
          isPersonalReminderOwner(resource.data)
          || isFamilyMember(resource.data.familyId)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["doneByUid"])
          || !("doneByUid" in request.resource.data)
          || request.resource.data.doneByUid == request.auth.uid
        ));
      allow delete: if activeAccount() && (isPersonalReminderOwner(resource.data)
        || isFamilyMember(resource.data.familyId));
    }

    match /expenses/{expenseId} {
      allow read: if resource == null
        || isPersonalExpenseOwner(resource.data)
        || isFamilyMember(resource.data.familyId);
      allow create: if activeAccount() && (request.auth != null
        && request.resource.data.payerUid == request.auth.uid
        && (
          request.resource.data.familyId == null
          || isFamilyMember(request.resource.data.familyId)
        ));
      // Payer edits their own expense in both modes. Family members
      // can delete bad entries in family mode; personal owner deletes
      // in personal mode.
      allow update: if activeAccount() && (request.auth.uid == resource.data.payerUid);
      allow delete: if activeAccount() && (isPersonalExpenseOwner(resource.data)
        || isFamilyMember(resource.data.familyId));
    }

    // ── Posts (top-level, author-owned, friend/public visibility) ──
    function isFriend(authorUid, viewerUid) {
      return exists(/databases/$(database)/documents/users/$(authorUid)/friends/$(viewerUid));
    }

    // UGC moderation (docs/features/ugc-moderation.md): has `authorUid`
    // blocked the caller? Used to stop a blocked-by author's target from
    // commenting/reacting on that author's content — the "can't interact
    // with me" half of blocking (the "disappears from my feed" half is
    // client-side filtering over `blockedUids`, since rules can't filter
    // query results).
    function authorBlockedMe(authorUid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(authorUid))
        && request.auth.uid in
             get(/databases/$(database)/documents/users/$(authorUid)).data.get("blockedUids", []);
    }

    // Can the signed-in caller READ a post with this data? Mirrors the
    // posts/{postId} read rule so the comments subcollection can reuse the
    // exact same visibility logic via a get() on the parent post.
    function canReadPost(postData) {
      return request.auth != null && (
        postData.visibility == "public"
        || postData.authorUid == request.auth.uid
        || (postData.visibility == "friends"
            && isFriend(postData.authorUid, request.auth.uid))
      );
    }

    match /posts/{postId} {
      // Native RN Firebase uses double-valued increment transforms. Enforce
      // whole counts, not a particular wire representation; reject fractions,
      // NaN/infinity and values outside exact JavaScript integer arithmetic.
      function validCount(value) {
        return value is number && value >= 0 && value <= 9007199254740991
          && value == math.floor(value);
      }
      function validCounts(c) {
        return c is map && c.keys().hasOnly(['❤️', '😂', '🐶', '👍', '🎉'])
          && validCount(c['❤️']) && validCount(c['😂'])
          && validCount(c['🐶']) && validCount(c['👍']) && validCount(c['🎉']);
      }
      function countDelta(before, after, oldEmoji, newEmoji, emoji) {
        return after[emoji] == before.get(emoji, 0)
          - (oldEmoji == emoji ? 1 : 0) + (newEmoji == emoji ? 1 : 0);
      }
      // Both the post and the reaction must agree in the same atomic write.
      function validReactionChange() {
        let p = /databases/$(database)/documents/posts/$(postId);
        let r = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
        let before = get(p).data;
        let after = getAfter(p).data;
        let oldEmoji = exists(r) ? get(r).data.emoji : null;
        let newEmoji = existsAfter(r) ? getAfter(r).data.emoji : null;
        let counts = before.get('reactionCounts', {});
        return isRealUser() && canReadPost(before) && !authorBlockedMe(before.authorUid)
          && oldEmoji != newEmoji
          && after.diff(before).affectedKeys().hasOnly(['reactionCounts'])
          && validCounts(after.reactionCounts)
          && countDelta(counts, after.reactionCounts, oldEmoji, newEmoji, '❤️')
          && countDelta(counts, after.reactionCounts, oldEmoji, newEmoji, '😂')
          && countDelta(counts, after.reactionCounts, oldEmoji, newEmoji, '🐶')
          && countDelta(counts, after.reactionCounts, oldEmoji, newEmoji, '👍')
          && countDelta(counts, after.reactionCounts, oldEmoji, newEmoji, '🎉');
      }
      allow read: if canReadPost(resource.data);

      // Guests can't post (community feature, needs a real identity).
      // Spec guest-login.md §C/§D.
      allow create: if activeAccount() && (isRealUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.visibility in ["private", "friends", "public"]
        && validCounts(request.resource.data.reactionCounts)
        // Map equality distinguishes integer from double elements. Compare
        // each numeric value so native zero-valued doubles can create posts.
        && request.resource.data.reactionCounts['❤️'] == 0
        && request.resource.data.reactionCounts['😂'] == 0
        && request.resource.data.reactionCounts['🐶'] == 0
        && request.resource.data.reactionCounts['👍'] == 0
        && request.resource.data.reactionCounts['🎉'] == 0
        && !request.resource.data.keys().hasAny(['hidden', 'reportCount', 'commentCount']));

      allow update: if activeAccount() && (request.auth != null && (
        (resource.data.authorUid == request.auth.uid
          // `hidden`/`reportCount` are moderation state — Admin SDK only
          // (onReportCreated), never client-writable, not even by the
          // post's own author. Spec docs/features/ugc-moderation.md.
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(["hidden", "reportCount", "reactionCounts", "commentCount", "authorUid", "createdAt"]))
        // A reactor may change only the exact delta authorized by their
        // atomic reaction transition. commentCount stays Admin-only.
        || validReactionChange()
      ));

      allow delete: if activeAccount() && (request.auth.uid == resource.data.authorUid);

      // Reactions are a community action — guests can read but not write.
      // Blocked-by-the-author callers are rejected too (ugc-moderation.md).
      match /reactions/{uid} {
        allow read: if canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create, update: if activeAccount() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'emoji', 'reactedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.emoji in ['❤️', '😂', '🐶', '👍', '🎉']
          && request.resource.data.reactedAt == request.time
          && validReactionChange();
        allow delete: if activeAccount() && request.auth.uid == uid && validReactionChange();
      }

      // ── Comments (feed interaction v2) ──
      // Permission mirrors the parent post's visibility: anyone who can
      // read the post can read + add comments. Spec docs/features/
      // feed-comments-and-reactions-v2.md §A. `post.commentCount` is
      // maintained by the onCreate/onDelete Cloud Functions (Admin SDK).
      match /comments/{commentId} {
        // get() the parent post once and reuse the visibility check.
        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }
        allow read: if canReadPost(parentPost());

        // Author writes their own comment, must be able to read the post,
        // and text must be a trimmed-non-empty string within the length cap
        // (mirrors COMMENT_MAX_LEN in shared-types). createdAt must be the
        // server timestamp so ordering can't be spoofed. Guests can't
        // comment (community feature). Spec guest-login.md §C.
        allow create: if activeAccount() && (isRealUser()
          && request.resource.data.authorUid == request.auth.uid
          && canReadPost(parentPost())
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          // Blocked-by-the-post-author callers can't comment either
          // (ugc-moderation.md — the "can't interact with me" half).
          && !authorBlockedMe(parentPost().authorUid));

        // No edits in v1 (open question #1 — PM default: not editable).
        // `hidden`/`reportCount` are Admin-SDK-only regardless (see above).
        allow update: if false;

        // Comment author deletes their own; post author moderates any
        // comment on their post.
        allow delete: if activeAccount() && (request.auth != null && (
          request.auth.uid == resource.data.authorUid
          || request.auth.uid == parentPost().authorUid
        ));
      }
    }

    // ── UGC moderation: reports + audit trail (App Store Guideline 1.2) ──
    // Spec docs/features/ugc-moderation.md. Write-only from the client —
    // there's no admin dashboard; the developer reviews via the Firestore
    // console, and `onReportCreated` (Admin SDK, bypasses these rules)
    // bumps reportCount/hidden and writes the audit doc.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if activeAccount() && (isRealUser()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ["post", "comment", "user"]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetAuthorUid is string
        && request.resource.data.reason in ["spam", "harassment", "inappropriate", "other"]
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time
        // Reporting a comment must carry the parent postId (the trigger
        // needs it to reach posts/{postId}/comments/{commentId}).
        && (request.resource.data.targetType != "comment"
            || (request.resource.data.postId is string
                && request.resource.data.postId.size() > 0)));
    }

    match /moderationAudit/{auditId} {
      allow read, write: if false; // Admin SDK only (onReportCreated).
    }

    // One vote per reporter/canonical target plus authoritative unique count.
    // Both are maintained atomically with moderationAudit by onReportCreated.
    match /moderationVotes/{voteId} {
      allow read, write: if false;
    }
    match /moderationTargetState/{targetKey} {
      allow read, write: if false;
    }

    // ── Restaurants & reviews ──
    match /restaurants/{rid} {
      allow read: if true;
      allow create: if activeAccount() && (request.auth != null
        && request.resource.data.submittedByUid == request.auth.uid);
      allow update, delete: if false;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if activeAccount() && (request.auth != null
          && request.resource.data.authorUid == request.auth.uid);
        allow update, delete: if activeAccount() && (request.auth.uid == resource.data.authorUid);
      }
    }

    // ── Knowledge articles (public read, admin write later) ──
    match /knowledgeArticles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Leaderboards (read-anyone, write only via Cloud Functions) ──
    match /leaderboards/{period} {
      allow read: if request.auth != null;
      allow write: if false;

      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Dog-centric leaderboards v2 (read-anyone signed-in, write only
    //    via Cloud Functions). Same posture as the walker board above.
    //    Client-side tab filtering (all-app vs friends, ownerVisibility,
    //    own-dog-always-visible) happens in the reader — the denormalised
    //    ownerUid / ownerVisibility fields make that possible without
    //    cross-family pet reads. Spec leaderboard-v2-dog-centric.md. ──
    match /dogLeaderboards/{period} {
      allow read: if request.auth != null;
      allow write: if false;

      match /entries/{petId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── postInteractionThrottle (server-only) ──
    // Per-post reaction-push throttle state, written by the onReactionCreated
    // trigger via Admin SDK (rules bypass). Holds reactionLastPushAt +
    // reactionPending to collapse reaction-push bursts into ≤1 push/hour/post.
    // No client surface. Spec feed-comments-and-reactions-v2.md §C.
    match /postInteractionThrottle/{postId} {
      allow read, write: if false;
    }

    // ── anonymousGc audit log (server-only) ──
    // Written by the gcAnonymousUsers scheduled function (guest account
    // garbage collection) via Admin SDK. One doc per run keyed by ISO,
    // records the dry-run/real flag + scanned/eligible/reaped counts + a
    // sample of reaped uids. No client surface. Spec guest-login.md §F.
    match /anonymousGc/{id} {
      allow read, write: if false;
    }

    // ── achievementsBackfills audit log (admin/server-only) ──
    // Written by the backfillAchievements callable via Admin SDK. One doc
    // per real (non-dry-run) backfill keyed by ISO; records processed /
    // granted counts + a sample. No client surface. Spec
    // achievements-badges.md §F.
    match /achievementsBackfills/{id} {
      allow read, write: if false;
    }

    // ── piiMigrations audit log (server-only) ──
    // Written by the migrate-user-pii.mjs script (security-hardening #2)
    // via Admin SDK. One doc per commit run keyed by ISO. No client surface.
    match /piiMigrations/{id} {
      allow read, write: if false;
    }

    // ── deletedAccounts audit log (admin/server-only) ──
    // The per-UID checkpoint is written before deletion starts. It freezes
    // client mutations while cleanup/finalization retries. Legacy audit IDs
    // may coexist; neither checkpoints nor pending work are client writable.
    match /deletedAccounts/{id} {
      allow read, write: if false;
    }

    // ── legacyCleanups audit log (admin/server-only) ──
    // Written by the cleanupLegacyPaths callable + matching admin script
    // (functions/scripts/run-legacy-cleanup.mjs) via Admin SDK. Same
    // posture as deletedAccounts — admin-only, inspectable via Firebase
    // Console; no client surface.
    match /legacyCleanups/{id} {
      allow read, write: if false;
    }

    // ── displayNameLowerBackfills audit log (admin/server-only) ──
    // Written by the backfillDisplayNameLower callable + matching admin
    // script (functions/scripts/run-backfill-display-name-lower.mjs) via
    // Admin SDK. Same posture as deletedAccounts / legacyCleanups —
    // admin-only, inspectable via Firebase Console; no client surface.
    match /displayNameLowerBackfills/{id} {
      allow read, write: if false;
    }

    // ── engagementPushes audit log (admin/server-only) ──
    // Written by the scheduled engagement-push functions
    // (eveningWalkReminder / streakBreakWarning / aggregateLeaderboards
    // rank-overtake branch / familyGoalMilestone) via Admin SDK. One
    // doc per push wave keyed by {type}/{ISO} so we can audit who
    // received what. Same client-locked posture as the other audit
    // collections above. Spec docs/features/
    // engagement-push-notifications.md Phase 4.
    match /engagementPushes/{document=**} {
      allow read, write: if false;
    }

    // ── realtimeLeaderboardUpdates audit log (admin/server-only) ──
    // Written by the recomputeWalkerLeaderboards onCreate(walks/{walkId})
    // trigger via Admin SDK. One doc per trigger fire keyed by
    // {walkerUid}_{ISO} so we can spot-check that a given walk
    // triggered the expected score recompute. Spec docs/features/
    // family-leaderboard-realtime.md.
    match /realtimeLeaderboardUpdates/{document=**} {
      allow read, write: if false;
    }

    // ── orphanWalkPurges audit log (server-only) ──
    // Written by the purgeMyOrphanWalks callable when a user cleans up
    // walks under a family they've left. One doc per invocation keyed
    // by {uid}_{ISO}, captures the orphan list even on dryRun.
    match /orphanWalkPurges/{document=**} {
      allow read, write: if false;
    }

    // ── autoFriendEvents audit log (server-only) ──
    // Written by the autoFriendFamilyMembers onWrite(families/{familyId})
    // trigger when new uids land in memberUids. One doc per fire keyed
    // by {familyId}_{ISO}; captures created/skipped pair counts +
    // reasons so we can spot abuse / runaway loops. Spec docs/features/
    // auto-friend-family-members.md.
    match /autoFriendEvents/{document=**} {
      allow read, write: if false;
    }

    // A separate server-only bucket prevents profile edits from resetting quota.
    match /familyJoinAttempts/{document=**} {
      allow read, write: if false;
    }

    // ── userDailyStats — per-user per-day flags (server writes only) ──
    // Currently holds the `goalHitNotifiedAt` field used by the B2
    // family-milestone push to dedupe (one push per achiever per day).
    // Doc id format: `{uid}_{YYYY-MM-DD}` so the lookup is a single
    // get() inside the trigger. Users can READ their own day to power
    // future client-side stats; writes are admin-only.
    match /userDailyStats/{statId} {
      // statId is "{uid}_{YYYY-MM-DD}". A safe id-prefix match keeps
      // user A from peeking at user B's stats while still allowing
      // simple client `getDoc()` reads of their own.
      allow read: if request.auth != null
        && statId.matches("^" + request.auth.uid + "_.*$");
      allow write: if false;
    }
  }
}
